<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TraineeXP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.TraineeXP" parent="Base.Theme.TraineeXP" />

    <!-- MainActivity's theme until installSplashScreen() switches it to
         postSplashScreenTheme (see MainActivity.onCreate) — backed by
         androidx.core:core-splashscreen so this also applies pre-API31,
         where there's no system splash screen otherwise. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/triangle_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.TraineeXP</item>
    </style>
</resources>